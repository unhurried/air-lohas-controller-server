{
  "name": "air-lohas-controller-server",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:stg": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env stg",
    "cf:deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env prod"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
