{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ac",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"env": {
		"stg": {
			"name": "ac-stg1",
			"durable_objects": {
				"bindings": [
					{
						"name": "AC_STATE",
						"class_name": "AirconStateDO"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"AirconStateDO"
					]
				}
			]
		},
		"prod": {
			"name": "ac",
			"durable_objects": {
				"bindings": [
					{
						"name": "AC_STATE",
						"class_name": "AirconStateDO"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"AirconStateDO"
					]
				}
			]
		}
	}
}
